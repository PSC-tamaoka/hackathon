# Edge Functions 用のシークレット（supabase secrets set --env-file supabase/.env で登録する）
# このファイルをコピーして supabase/.env を作り、値を入れる（.env はコミットしない）

# Resend の API キーと送信元（送信元は Resend で認証したドメインのアドレス）
RESEND_API_KEY=
MAIL_FROM=渋川つながり <invite@your-domain.jp>

# pg_cron から呼ばれたことの確認用。cron.sql の cron_secret と同じ値にする（長いランダム文字列）
CRON_SECRET=

# 招待ページの URL の頭。メールのリンクは <これ>/invite/<token> になる
#   アプリの Web 版を公開した URL か、開発中なら Expo の URL（例: exp://192.168.0.10:8081/--）
INVITE_BASE_URL=

# 配信停止リンクの署名用（CRON_SECRET とは別の長いランダム文字列）
UNSUBSCRIBE_SECRET=

# 任意
MAIL_SENDER_INFO=渋川つながり運営チーム
MAX_EMAILS_PER_RUN=100
